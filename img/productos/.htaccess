# Las fotos de producto de CADA tenant viven en subcarpetas de este directorio
# (img/productos/{cuit}/{codigo}.jpg). El sistema es multi-tenant en un solo
# dominio/webroot, así que el acceso HTTP directo a estos archivos está
# bloqueado a propósito: SIEMPRE deben servirse a través de img_producto.php,
# que valida sesión + que el producto pertenezca al tenant conectado antes
# de leer el archivo del disco (la lectura por PHP no pasa por estas reglas,
# solo el acceso HTTP directo).

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (compatibilidad)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
